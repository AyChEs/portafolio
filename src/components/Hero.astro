---
import Brand from './Brand.astro';
import { UI, WHAT_I_DO, PERSON, type Lang } from '../content/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = UI[lang];

---
<script is:inline>
  // Primera visita de la sesión: se enciende la apertura antes del primer pintado (scripts/brand.ts la ejecuta).
  try {
    if (!sessionStorage.getItem('opened') && !location.hash && !scrollY && !matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('js-open');
  } catch (e) {}
</script>
<div class="open" aria-hidden="true"></div>
<canvas id="field" class="field" aria-hidden="true"></canvas>
<div class="hero">
  <div class="dots" aria-hidden="true"></div><div class="glow" aria-hidden="true"></div>
  <div class="wrap">
    <dl class="ficha">
      <div><dt>{t.fiName}</dt><dd>Ayman Charoui</dd></div>
      <div><dt>{t.fiWhere}</dt><dd>{t.fiWhereV} <span class="c">41.12°N 1.24°E</span></dd></div>
      <div><dt>{t.fiRole}</dt><dd>{t.fiRoleV}</dd></div>
      <div><dt>{t.fiTime}</dt><dd><time data-clock>--:--</time> <span class="c">CET</span></dd></div>
    </dl>
    <div class="hero-grid">
      <div>
        <h1><Brand role="hero" label={`Ayman Charoui, ${t.leadStrong.replace('.', '').toLowerCase()}`} /></h1>
        <p class="lead"><strong>{t.leadStrong}</strong> {t.lead}</p>
        <div class="cta">
          <a class="btn p" href="#contacto" data-magnetic>{t.talk}</a>
          <a class="btn s" href={PERSON.cv[lang]} download>{t.downloadCV} ↓</a>
          <a class="more" href="#casos">{t.seeProjects} →</a>
        </div>
      </div>
      <aside class="index" aria-label={t.whatIDo.replace('// ', '')}>
        <span class="k">{t.whatIDo}</span>
        {WHAT_I_DO[lang].map((w, i) => (
          <div class="it"><span class="n">{String(i + 1).padStart(2, '0')}</span><span><b>{w.t}</b><small>{w.s}</small></span></div>
        ))}
      </aside>
    </div>
    <div class="proof"><span>{t.proof1}</span><span>{t.proof2}</span><span>{t.proof3}</span></div>
  </div>
</div>
<script>
  // Hora local de Tarragona en la ficha; se actualiza cada minuto.
  const clock = document.querySelector<HTMLTimeElement>('[data-clock]');
  if (clock) {
    const fmt = new Intl.DateTimeFormat('es-ES', { timeZone: 'Europe/Madrid', hour: '2-digit', minute: '2-digit' });
    const zone = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Madrid', timeZoneName: 'short' });
    const tick = () => {
      const now = new Date();
      clock.textContent = fmt.format(now);
      clock.dateTime = now.toISOString();
      const z = zone.formatToParts(now).find((p) => p.type === 'timeZoneName')?.value;
      if (z && clock.nextElementSibling) clock.nextElementSibling.textContent = z.replace('GMT+1', 'CET').replace('GMT+2', 'CEST');
    };
    tick(); setInterval(tick, 30_000);
  }
  // El fondo vivo se descarga y arranca con el primer gesto del visitante (como las animaciones de scroll):
  // así no pesa en la carga. Hasta entonces, y con «reducir movimiento», se ve la retícula .
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const events = ['pointermove', 'pointerdown', 'touchstart', 'wheel', 'scroll', 'keydown'];
    const go = () => {
      events.forEach((e) => removeEventListener(e, go));
      import('../scripts/field').then((m) => m.boot()).catch(() => {});
    };
    if (scrollY > 40) go(); else events.forEach((e) => addEventListener(e, go, { passive: true }));
  }
</script>
