---
import Lambda from './Lambda.astro';
import { UI, BIO, PATH, LANGS, NOW, PERSON, type Lang } from '../content/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = UI[lang];
const n = NOW[lang];
---
<section id="sobre"><div class="wrap">
  <div class="about">
    <div class="bio">
      <span class="k">{t.aboutKicker}</span>
      <div class="sh" style="margin-bottom:28px"><h2>{t.aboutTitle}<i>.</i></h2></div>
      {BIO[lang].map((p) => <p set:html={p} />)}
      <div class="cta"><a class="btn p" href={PERSON.cv[lang]} download>{t.downloadCV}</a><a class="btn s" href={PERSON.cv[lang === 'es' ? 'en' : 'es']} download>{t.cvOther}</a></div>
    </div>
    <div class="side">
      <div class="box place"><div class="globe"><img src="/img/globo.webp" alt="" width="120" height="120" loading="lazy" /></div><div><span class="k">{t.whereK}</span><b>{t.whereT}</b><small>{t.whereS}</small></div></div>
      <div class="box"><span class="k">{t.pathK}</span>
        <ul class="tl">{PATH[lang].map((p) => <li class={p.now ? 'now' : ''}><time>{p.when}</time><span>{p.t}<small>{p.s}</small></span></li>)}</ul>
      </div>
      <div class="box"><span class="k">{t.langsK}</span><div class="langs">{LANGS[lang].map(([c, l]) => <span><b>{c}</b>{l}</span>)}</div></div>
    </div>
  </div>

  <div class="ahora">
    <div class="head"><h3>{t.nowTitle}<i>.</i></h3><small>{t.nowSub}</small></div>
    <p>{t.nowIntro}</p>
    <div class="desk">
      <article class="obj pass" aria-label={n.tripK}>
        <div class="main">
          <header><span class="air"><b>λ</b>{n.tripK}</span><span>{lang === 'es' ? 'PASE DE EMBARQUE' : 'BOARDING PASS'}</span></header>
          <div class="route"><div><b>TGN</b><small>Tarragona</small></div><div class="path"><i></i></div><div style="text-align:right"><b>GRX</b><small>{n.tripCity}</small></div></div>
          <dl><div><dt>{lang === 'es' ? 'pasajero' : 'passenger'}</dt><dd>AYMAN C.</dd></div><div><dt>{lang === 'es' ? 'destino' : 'to'}</dt><dd>{n.tripCity}, {n.tripCountry}</dd></div><div><dt>{n.tripBestK}</dt><dd>{n.tripBest}</dd></div></dl>
        </div>
        <div class="stub"><span class="mono">{lang === 'es' ? 'EN TREN / COCHE' : 'GROUND'}</span><b>{n.tripCity}</b><div class="barcode"></div></div>
      </article>
      <article class="obj ticket" aria-label={n.filmK}>
        <span class="mono">{n.filmK}</span>
        <b class="film">{n.film}</b>
        <div class="seat"><span>{lang === 'es' ? 'SALA' : 'SCREEN'}<b>3</b></span><span>{lang === 'es' ? 'FILA' : 'ROW'}<b>F</b></span><span>{lang === 'es' ? 'BUTACA' : 'SEAT'}<b>7</b></span></div>
        <div class="rate" role="img" aria-label={lang === 'es' ? 'Nota: 3,5 de 5' : 'Rating: 3.5 out of 5'}><i class="f"></i><i class="f"></i><i class="f"></i><i class="h"></i><i></i></div>
        <p class="note-film">{n.filmNote}</p>
        <div class="tear"><span>{lang === 'es' ? 'UNA BUTACA' : 'ONE SEAT'}</span><span>{lang === 'es' ? 'UNA COMPRA' : 'ONE PURCHASE'}</span></div>
      </article>
      <article class="obj card-lib" aria-label={n.bookK}>
        <header><span>{n.bookK}</span><span>Nº 001</span></header>
        <div class="f">
          <div><span>{n.bookTitleK}</span><b class="bt">{n.bookTitle}</b></div>
          <div><span>{lang === 'es' ? 'subtítulo' : 'subtitle'}</span><b class="bs">{n.bookSub}</b></div>
          <div><span>{n.bookAuthorK}</span><b>{n.bookAuthor}</b></div>
          <div><span>{n.bookStateK}</span><b>{n.bookState}</b></div>
        </div>
        <div class="stamp" set:html={n.stamp} />
      </article>
      <article class="obj punch" aria-label={n.gymK}>
        <header><span>{n.gymK}</span><span>Nº 001</span></header>
        <div class="member">
          <div class="ph" aria-hidden="true"><Lambda /></div>
          <div><span class="lbl">{n.gymSportK}</span><b>{n.gymSport}</b><span class="lbl">AYMAN C.</span></div>
        </div>
        <div class="foot"><i>{n.gymFoot}</i></div>
      </article>
    </div>
  </div>
</div></section>
