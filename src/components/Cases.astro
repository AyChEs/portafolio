---
import { UI, CASES, ROUTES, type Lang } from '../content/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = UI[lang];

// Marca v3: cada caso se ilustra con su maqueta 3D y unas tarjetas de interfaz con datos reales del caso
// (los mismos que cuenta su página). Las capturas siguen en la página de cada caso.
type Frag = { k: string; v: string; ok?: boolean };
const MAQ: Record<string, { img: string; alt: Record<Lang, string>; frags: Record<Lang, Frag[]>}> = {
  saas: {
    img: 'etecnic',
    alt: { es: 'Maqueta ilustrada de una subestación eléctrica y una torre de control unidas por un cable con luces', en: 'Illustrated model of an electrical substation and a control tower linked by a lit cable' },
    frags: {
      es: [{ k: 'factura.pdf', v: '9 idiomas' }, { k: 'plantilla', v: 'HTML + CSS' }, { k: 'CI · plantillas', v: 'probadas', ok: true }],
      en: [{ k: 'invoice.pdf', v: '9 languages' }, { k: 'template', v: 'HTML + CSS' }, { k: 'CI · templates', v: 'tested', ok: true }],
    },
  },
  zellige: {
    img: 'zellige',
    alt: { es: 'Maqueta ilustrada de un hotel en corte, con una habitación iluminada', en: 'Illustrated cut-away model of a hotel with one room lit' },
    frags: {
      es: [{ k: 'perfiles', v: '4 roles' }, { k: 'refresh token', v: 'rota en cada uso' }, { k: 'backend', v: '31 pruebas', ok: true }],
      en: [{ k: 'profiles', v: '4 roles' }, { k: 'refresh token', v: 'rotates on use' }, { k: 'backend', v: '31 tests', ok: true }],
    },
  },
  cineflow: {
    img: 'cineflow',
    alt: { es: 'Maqueta ilustrada de una sala de cine con tres butacas reservadas en azul', en: 'Illustrated model of a cinema with three seats reserved in blue' },
    frags: {
      es: [{ k: 'butacas', v: '3 retenidas' }, { k: 'PHPUnit', v: '76 pruebas', ok: true }, { k: 'doble venta', v: 'imposible', ok: true }],
      en: [{ k: 'seats', v: '3 held' }, { k: 'PHPUnit', v: '76 tests', ok: true }, { k: 'double sale', v: 'impossible', ok: true }],
    },
  },
  lacomu: {
    img: 'lacomu',
    alt: { es: 'Maqueta ilustrada de una plaza de barrio con un tablón de anuncios y una rampa de acceso', en: 'Illustrated model of a neighbourhood square with a noticeboard and an access ramp' },
    frags: {
      es: [{ k: 'accesibilidad', v: '39 → 0 fallos', ok: true }, { k: 'idiomas', v: '6 completos' }, { k: 'páginas', v: '7 revisadas' }],
      en: [{ k: 'accessibility', v: '39 → 0 issues', ok: true }, { k: 'languages', v: '6 complete' }, { k: 'pages', v: '7 checked' }],
    },
  },
};
---
<section id="casos"><div class="wrap">
  <div class="sh"><div><span class="k">{t.casesKicker}</span><h2>{t.casesTitle}<i>.</i></h2></div><p>{t.casesIntro}</p></div>
  {CASES.map((c) => (
    <article class="case">
      <div class="reveal" style={`view-transition-name:case-box-${c.id}`}>
      <a class="vis-link" href={`${ROUTES[lang].cases}${c.slug[lang]}/`} tabindex="-1" aria-hidden="true">
      {(() => { const m = MAQ[c.id]; return (
        <div class="vis maq" data-maq>
          <div class="px" style={`view-transition-name:case-vis-${c.id}`}>
            <img src={`/img/maquetas/${m.img}-1344.webp`} srcset={`/img/maquetas/${m.img}-720.webp 720w, /img/maquetas/${m.img}-1344.webp 1344w`} sizes="(max-width: 760px) 92vw, 640px" alt={m.alt[lang]} width="1344" height="752" loading="lazy" decoding="async" />
          </div>
          <ul class="frags">
            {m.frags[lang].map((f, i) => <li class={`f${i + 1}`}><span>{f.k}</span><b>{f.ok && <i aria-hidden="true">✓</i>}{f.v}</b></li>)}
          </ul>
        </div>
      ); })()}
      </a>
      </div>
      <div class="ctext">
        <span class="k">// {c.kicker[lang]}</span>
        <h3 style={`view-transition-name:case-title-${c.id}`}>{c.title[lang]}</h3>
        <dl class="dl">
          <div><dt>{t.problem}</dt><dd>{c.problem[lang]}</dd></div>
          <div><dt>{t.decision}</dt><dd>{c.decision[lang]}</dd></div>
          <div><dt>{t.result}</dt><dd>{c.result[lang]}</dd></div>
        </dl>
        <div class="tags">{c.tags.map((x) => <span>{x}</span>)}</div>
        <div class="links">
          <a href={`${ROUTES[lang].cases}${c.slug[lang]}/`}>{t.readCase} →</a>
          {c.meta.code && <a href={c.meta.code} target="_blank" rel="noopener">{t.code} ↗</a>}
          {c.meta.demo && <a href={c.meta.demo} target="_blank" rel="noopener">{t.demo} ↗</a>}
        </div>
      </div>
    </article>
  ))}
</div></section>
<script>
  // Las tarjetas de interfaz entran escalonadas cuando el visual del caso está a la vista.
  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('on'); io.unobserve(e.target); } }), { threshold: 0.45 });
  document.querySelectorAll('[data-maq]').forEach((el) => io.observe(el));
</script>
