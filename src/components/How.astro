---
import { UI, HOW, type Lang } from '../content/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = UI[lang];
---
<section id="como"><div class="wrap">
  <div class="sh"><div><span class="k">{t.howKicker}</span><h2>{t.howTitle}<i>.</i></h2></div><p>{t.howIntro}</p></div>
  <div class="steps">
    {HOW[lang].map((s, i) => <div class="step"><span class="n">{String(i + 1).padStart(2, '0')}</span><h3>{s.t}</h3><p>{s.s}</p></div>)}
  </div>
</div></section>
