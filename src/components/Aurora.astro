---
// Fondo vivo de todas las páginas (marca v3): tres manchas de luz en azul marino que derivan despacio,
// cambian de sitio según la sección que se está leyendo y llevan un grano fino encima.
// Es continuo (sin bandas). Con «reducir movimiento» se queda quieto en la posición de cada sección.
---
<div class="aurora" aria-hidden="true"><i class="b1"></i><i class="b2"></i><i class="b3"></i><span class="grain"></span></div>
<script>
  // La sección que ocupa el centro de la pantalla decide la «escena» del fondo.
  const root = document.documentElement;
  const map: Record<string, string> = { casos: 'casos', stack: 'stack', como: 'como', sobre: 'sobre', proyecto: 'proyecto', contacto: 'contacto' };
  const targets = [...document.querySelectorAll<HTMLElement>('section[id], footer[id], .taller, .chead, .body')];
  if ('IntersectionObserver' in window && targets.length) {
    const io = new IntersectionObserver((es) => {
      for (const e of es) {
        if (!e.isIntersecting) continue;
        const el = e.target as HTMLElement;
        root.dataset.scene = map[el.id] ?? (el.classList.contains('taller') ? 'taller' : el.classList.contains('body') ? 'casos' : 'inicio');
      }
    }, { rootMargin: '-45% 0px -45% 0px' });
    targets.forEach((t) => io.observe(t));
  }
  if (!root.dataset.scene) root.dataset.scene = 'inicio';
</script>
