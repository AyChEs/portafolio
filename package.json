{
  "name": "ayman-portafolio",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "Portafolio de Ayman Charoui: Astro en Cloudflare Pages",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "audit": "node scripts/auditoria.mjs",
    "lhci": "CHROME_PATH=\"$(node -e 'process.stdout.write(require(\"playwright-core\").chromium.executablePath())')\" lhci autorun",
    "lhci:mobile": "CHROME_PATH=\"$(node -e 'process.stdout.write(require(\"playwright-core\").chromium.executablePath())')\" lhci autorun --config=lighthouserc.mobile.json"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "astro": "^7.3.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "typescript": "^6.0.3"
  }
}
